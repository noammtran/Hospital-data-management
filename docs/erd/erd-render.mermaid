erDiagram
    PATIENTS ||--o{ ADMISSIONS : has
    PATIENTS ||--o{ DIAGNOSES : has
    PATIENTS ||--o{ PRESCRIPTIONS : has
    PATIENTS ||--o{ APPOINTMENTS : has
    PATIENTS ||--o{ PATIENT_HISTORY : audit

    ADMISSIONS }o--|| DEPARTMENTS : in
    ADMISSIONS }o--|| DOCTORS : attended_by
    ADMISSIONS }o--o| ROOMS : assigned_to
    ADMISSIONS ||--o{ DIAGNOSES : during
    ADMISSIONS ||--o{ PRESCRIPTIONS : during

    DOCTORS }o--|| DEPARTMENTS : works_in
    ROOMS }o--|| DEPARTMENTS : located_in

    DIAGNOSES }o--|| DOCTORS : made_by
    PRESCRIPTIONS }o--|| DOCTORS : written_by
    PRESCRIPTIONS }o--|| MEDICINES : for
    PRESCRIPTIONS }o--|| DIAGNOSES : based_on

    APPOINTMENTS }o--|| DOCTORS : with
    APPOINTMENTS }o--|| DEPARTMENTS : at

    PATIENTS {
        VARCHAR36 ID PK
        VARCHAR100 FULL_NAME
        DATE BIRTH_DATE
        NUMBER GENDER_CD FK
        VARCHAR255 ADDRESS
        VARCHAR20 PHONE_NO
        VARCHAR50 EMAIL
        VARCHAR20 IDENTITY_NO
        NUMBER BLOOD_TYPE_CD FK
        VARCHAR500 ALLERGIES
        VARCHAR1000 MEDICAL_HISTORY
        VARCHAR20 INSURANCE_NO
        DATE INSURANCE_EXPIRY
        VARCHAR100 EMERGENCY_CONTACT_NAME
        VARCHAR20 EMERGENCY_CONTACT_PHONE
        VARCHAR50 EMERGENCY_CONTACT_RELATION
        NUMBER STATUS_CD FK
        VARCHAR1000 NOTES
        VARCHAR30 CREATED_BY
        DATE CREATED_DATE
        VARCHAR30 LAST_UPDATED_BY
        DATE LAST_UPDATED_DATE
    }

    ADMISSIONS {
        VARCHAR36 ID PK
        VARCHAR36 PATIENT_ID FK
        NUMBER DEPARTMENT_ID FK
        NUMBER DOCTOR_ID FK
        NUMBER ROOM_ID FK
        DATE ADMISSION_DATE
        DATE DISCHARGE_DATE
        VARCHAR500 ADMISSION_REASON
        NUMBER ADMISSION_TYPE_CD FK
        NUMBER STATUS_CD FK
        VARCHAR500 NOTES
    }

    DEPARTMENTS {
        NUMBER ID PK
        VARCHAR100 DEPARTMENT_NAME UK
        VARCHAR255 DESCRIPTION
    }

    DOCTORS {
        NUMBER ID PK
        VARCHAR20 DOCTOR_CODE UK
        VARCHAR100 FULL_NAME
        VARCHAR100 SPECIALIZATION
        VARCHAR20 PHONE_NO
        VARCHAR50 EMAIL
        NUMBER DEPARTMENT_ID FK
        NUMBER STATUS_FLG
    }

    ROOMS {
        NUMBER ID PK
        VARCHAR50 ROOM_NAME UK
        NUMBER ROOM_TYPE_CD FK
        NUMBER DEPARTMENT_ID FK
        NUMBER BED_COUNT
        NUMBER CURRENT_OCCUPANCY
        NUMBER STATUS_FLG
    }

    MEDICINES {
        NUMBER ID PK
        VARCHAR200 MEDICINE_NAME UK
        VARCHAR200 GENERIC_NAME
        NUMBER MEDICINE_TYPE_CD FK
        VARCHAR20 UNIT
        VARCHAR200 MANUFACTURER
        VARCHAR500 DESCRIPTION
        VARCHAR500 SIDE_EFFECTS
        NUMBER STATUS_FLG
    }

    ICD10_CODES {
        NUMBER ID PK
        VARCHAR10 ICD_CODE UK
        VARCHAR100 SHORT_DESC
        VARCHAR255 LONG_DESC
        NUMBER HIPAA_COVERED
        NUMBER STATUS_FLG
    }

    DIAGNOSES {
        VARCHAR36 ID PK
        VARCHAR36 PATIENT_ID FK
        VARCHAR36 ADMISSION_ID FK
        NUMBER DOCTOR_ID FK
        DATE DIAGNOSIS_DATE
        VARCHAR10 ICD_CODE
        VARCHAR500 DIAGNOSIS_DESC
        NUMBER SEVERITY_CD FK
        VARCHAR500 NOTES
    }

    PRESCRIPTIONS {
        VARCHAR36 ID PK
        VARCHAR36 PATIENT_ID FK
        VARCHAR36 ADMISSION_ID FK
        NUMBER DOCTOR_ID FK
        VARCHAR36 DIAGNOSIS_ID FK
        NUMBER MEDICINE_ID FK
        DATE PRESCRIPTION_DATE
        VARCHAR100 DOSAGE
        VARCHAR100 FREQUENCY
        VARCHAR50 DURATION
        VARCHAR500 INSTRUCTIONS
    }

    APPOINTMENTS {
        VARCHAR36 ID PK
        VARCHAR36 PATIENT_ID FK
        NUMBER DOCTOR_ID FK
        NUMBER DEPARTMENT_ID FK
        DATE APPOINTMENT_DATE
        VARCHAR10 APPOINTMENT_TIME
        VARCHAR500 REASON
        NUMBER STATUS_CD FK
        VARCHAR500 NOTES
    }

    PATIENT_HISTORY {
        VARCHAR36 ID PK
        VARCHAR36 PATIENT_ID FK
        VARCHAR50 FIELD_NAME
        VARCHAR255 OLD_VALUE
        VARCHAR255 NEW_VALUE
        VARCHAR30 CHANGED_BY
        DATE CHANGED_DATE
    }

    LOOKUP_VALUES {
        NUMBER ID PK
        VARCHAR255 LOOKUP_VALUE
        NUMBER LOOKUP_CD
        VARCHAR30 LOOKUP_GROUP
        NUMBER STATUS_FLG
        VARCHAR255 DESCRIPTION
    }
