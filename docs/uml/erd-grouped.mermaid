%% ERD — patient record, conceptual decomposition (readability-oriented).
%% The patient record is shown as a central PATIENT entity related to its
%% logical sub-groups. Physically these 1:1 groups are stored in a single
%% denormalised PATIENTS table; PATIENT_HISTORY is a separate 1:many table.
%% Audit columns (created_by/date, last_updated_by/date) are omitted for clarity.

erDiagram
    PATIENT ||--|| PATIENT_CONTACT          : "has"
    PATIENT ||--o| PATIENT_INSURANCE        : "covered by"
    PATIENT ||--o| EMERGENCY_CONTACT        : "reachable via"
    PATIENT ||--|| MEDICAL_PROFILE          : "described by"
    PATIENT ||--o{ PATIENT_HISTORY          : "audited in"

    PATIENT {
        varchar2 patient_id PK
        varchar2 patient_name
        date     patient_birth_date
        number   patient_gender
        varchar2 patient_identity_no
        number   patient_status
    }

    PATIENT_CONTACT {
        varchar2 patient_id FK
        varchar2 patient_address
        varchar2 patient_phone_no
        varchar2 patient_email
    }

    PATIENT_INSURANCE {
        varchar2 patient_id FK
        varchar2 patient_insurance_no
        date     patient_insurance_expiry
    }

    EMERGENCY_CONTACT {
        varchar2 patient_id FK
        varchar2 patient_emergency_contact_name
        varchar2 patient_emergency_contact_phone
        varchar2 patient_emergency_contact_relation
    }

    MEDICAL_PROFILE {
        varchar2 patient_id FK
        number   patient_blood_type
        varchar2 patient_allergies
        varchar2 patient_medical_history
    }

    PATIENT_HISTORY {
        varchar2 patient_history_id PK
        varchar2 patient_history_patient_id FK
        varchar2 patient_history_field_name
        varchar2 patient_history_old_value
        varchar2 patient_history_new_value
        varchar2 patient_history_changed_by
        date     patient_history_changed_date
    }
