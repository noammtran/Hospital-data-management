%% Test isolation — how the backend unit tests isolate one layer at a time.
%% Each test keeps the layer under test real and replaces its collaborators
%% with controllable stand-ins, so no real database or server is started.

flowchart LR
    subgraph SVC["Service-layer unit test"]
        direction TB
        ST["Test case<br/>(arranges inputs)"]:::test
        SUT1["PatientServiceImpl<br/>real — under test"]:::sut
        SD1["Patient storage<br/>stand-in"]:::stub
        SD2["Change-history storage<br/>stand-in"]:::stub
        ST ==>|"drive"| SUT1
        SUT1 -.->|"calls (canned reply)"| SD1
        SUT1 -.->|"calls (canned reply)"| SD2
    end

    subgraph CTL["Controller-layer unit test"]
        direction TB
        CT["Test case<br/>(simulated HTTP request)"]:::test
        SUT2["PatientController<br/>real — under test"]:::sut
        CD1["Business layer<br/>stand-in"]:::stub
        CT ==>|"drive endpoint"| SUT2
        SUT2 -.->|"calls (canned reply)"| CD1
    end

    NONE["NOT started during these tests:<br/>real Oracle database &nbsp;·&nbsp; real web server"]:::none

    SD1 -.-x NONE
    SD2 -.-x NONE
    CD1 -.-x NONE

    classDef test fill:#dbeafe,stroke:#1e40af,color:#1e3a8a;
    classDef sut  fill:#dcfce7,stroke:#166534,stroke-width:2px,color:#14532d;
    classDef stub fill:#fef3c7,stroke:#92400e,stroke-dasharray:5 3,color:#78350f;
    classDef none fill:#fee2e2,stroke:#991b1b,color:#7f1d1d;
