%% Activity Diagram — Overall examination workflow (QT-EX-01..06)
%% Updated: 2026-05-18 (English labels)

flowchart TD
    Start([Patient arrives]) --> Q1{Existing record?}

    Q1 -- "No" --> A1[Receptionist creates record]
    Q1 -- "Yes" --> A2[Look up by<br/>ID card / phone]

    A1 --> Q2{Schedule appointment?}
    A2 --> Q2

    Q2 -- "Yes" --> A3[Create APPOINTMENT]
    Q2 -- "No" --> A4[Enter examination queue]
    A3 --> A4

    A4 --> A5[Doctor starts examination]
    A5 --> A6[Clinical examination]
    A6 --> A7[Create DIAGNOSIS]

    A7 --> Q3{Admission required?}

    %% Outpatient branch
    Q3 -- "No (outpatient)" --> B1[Prescribe medicine]
    B1 --> B2[Close visit]
    B2 --> End1([Patient leaves])

    %% Inpatient branch
    Q3 -- "Yes" --> C1[Select room with bed]
    C1 --> C2[Assign room + admit]

    C2 --> D1{Under treatment}
    D1 -- "Continue" --> D1
    D1 -- "Need transfer" --> E1[Transfer department/room]
    E1 --> D1
    D1 -- "Ready to discharge" --> F1[Doctor discharges]
    F1 --> End2([End of treatment episode])

    %% Re-examination loop
    End1 -. "Re-examination later" .-> R1[Reset status]
    End2 -. "Re-examination later" .-> R1
    R1 --> Q2

    classDef patient fill:#dbeafe,stroke:#1e40af;
    classDef doctor fill:#dcfce7,stroke:#166534;
    classDef decision fill:#fef3c7,stroke:#92400e;
    classDef terminal fill:#fce7f3,stroke:#9f1239;
    class A1,A2,A3,A4 patient
    class A5,A6,A7,B1,B2,C1,C2,D1,E1,F1 doctor
    class Q1,Q2,Q3 decision
    class Start,End1,End2 terminal
