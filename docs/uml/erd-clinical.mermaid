%% Clinical structure read (read-only) by the medical-record and statistics views.
%% A patient's treatment episodes (ADMISSION) each group the DIAGNOSIS and
%% PRESCRIPTION entries recorded during that visit; reference entities supply the
%% readable names shown on screen. FK and audit columns omitted for clarity.

erDiagram
    PATIENT    ||--o{ ADMISSION    : "has visits"
    ADMISSION  ||--o{ DIAGNOSIS    : "records"
    ADMISSION  ||--o{ PRESCRIPTION : "issues"
    DIAGNOSIS  ||--o{ PRESCRIPTION : "leads to"
    DEPARTMENT ||--o{ ADMISSION    : "hosts"
    DOCTOR     ||--o{ ADMISSION    : "attends"
    DOCTOR     ||--o{ DIAGNOSIS    : "makes"
    MEDICINE   ||--o{ PRESCRIPTION : "named in"

    PATIENT {
        varchar2 patient_id PK
        varchar2 patient_name
    }
    ADMISSION {
        varchar2 admission_id PK
        date     admission_date
        date     admission_discharge_date
        number   admission_status
    }
    DIAGNOSIS {
        varchar2 diagnose_id PK
        varchar2 diagnose_icd_code
        varchar2 diagnose_desc
        number   diagnose_severity
    }
    PRESCRIPTION {
        varchar2 prescription_id PK
        varchar2 prescription_dosage
        varchar2 prescription_frequency
        varchar2 prescription_duration
    }
    DEPARTMENT {
        number   department_id PK
        varchar2 department_name
    }
    DOCTOR {
        number   doctor_id PK
        varchar2 doctor_name
    }
    MEDICINE {
        number   medicine_id PK
        varchar2 medicine_name
    }
