%% Lookup Code Dereference — how a small integer in a patient row becomes display text
%% Logical-level: describes behaviour, not the table schema

flowchart LR
    A["Patient row<br/>gender stored as 1"]
    B["Shared list of options<br/>━━━━━━━━━━━━━━━━<br/>GENDER, 1 → Nam<br/>GENDER, 2 → Nữ<br/>GENDER, 3 → Khác"]
    C["UI displays:<br/><b>Nam</b>"]

    A -->|"look up by<br/>group + code"| B
    B -->|"return<br/>display text"| C

    classDef row fill:#fef3c7,stroke:#92400e,color:#3a1d05;
    classDef lookup fill:#fce7f3,stroke:#9f1239,color:#3a0817;
    classDef ui fill:#dcfce7,stroke:#166534,color:#0a2415;
    class A row
    class B lookup
    class C ui
