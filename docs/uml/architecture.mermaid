%% Architecture Diagram — Logical 3-tier (design level, framework-agnostic)
%% Updated: 2026-05-22 (logical-level: no framework annotations, no Java types,
%% no SQL — only logical components and the data they exchange)

flowchart TB
    %% ========================= PRESENTATION =========================
    subgraph CLIENT["🖥️ Client (Browser)"]
        direction TB
        SCREENS["Patient screens<br/>(List, Detail, Form, History)"]
        NAV["Navigation"]
        VFORM["Form validation<br/>(required, format, length)"]
        VCALL["API caller<br/>(attaches access token)"]
        SCREENS --> NAV
        SCREENS --> VFORM
        SCREENS --> VCALL
    end

    %% ========================= APPLICATION =========================
    subgraph APP["⚙️ Application Server"]
        direction TB

        subgraph CTRL["🟦 API Layer"]
            REST["Patient API endpoints<br/>(receive request, return response)<br/>+ input validation<br/>+ unified error format"]
        end

        subgraph SVC["🟩 Business Layer"]
            BIZ["Patient business rules<br/>(duplicate check, status flow,<br/>delete-vs-archive policy)<br/>+ identity of current user"]
        end

        subgraph DAL["🟨 Data Access Layer"]
            REPO["Patient data access<br/>(search, fetch, save, remove)"]
            LIS["Change tracker<br/>→ records every field change"]
            REPO --- LIS
        end

        CTRL --> SVC
        SVC --> DAL
    end

    %% ========================= PERSISTENCE =========================
    subgraph DB["🗄️ Database"]
        direction TB
        TABLES["Patient records<br/>+ Change history<br/>+ Departments, Doctors,<br/>Rooms, Medicines, …"]
        OBJ["Keys, uniqueness rules,<br/>lookup values, indexes"]
        TABLES --- OBJ
    end

    %% ========================= EDGES =========================
    VCALL -. "Request / Response over HTTPS<br/>(JSON)" .-> CTRL
    DAL -. "Read / Write records" .-> DB

    %% Styling
    classDef view fill:#dbeafe,stroke:#1e40af;
    classDef ctrl fill:#dcfce7,stroke:#166534;
    classDef svc fill:#fef3c7,stroke:#92400e;
    classDef dal fill:#fce7f3,stroke:#9f1239;
    classDef db fill:#e5e7eb,stroke:#374151;
    class CLIENT view
    class CTRL ctrl
    class SVC svc
    class DAL dal
    class DB db
